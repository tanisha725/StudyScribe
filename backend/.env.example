# Copy this file to backend/.env and fill in your own keys.
# Never commit the real .env file.

# Groq API key - used for all AI features: summary, notes, topics, flashcards, quiz,
# and transcribing audio uploads.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Port the backend listens on. Optional, defaults to 5000.
# On macOS, port 5000 is often taken by AirPlay Receiver, so 5001 is a safer choice.
PORT=5000

# Optional. Comma-separated list of frontend URLs allowed to call this backend,
# for example https://your-app.vercel.app,http://localhost:3000
# If empty, any website can call it.
ALLOWED_ORIGINS=

# Optional. Groq model used for generation. Defaults to openai/gpt-oss-120b.
GROQ_MODEL=

# Optional. Maximum number of AI calls used to extract topics and concepts from one file.
# Each call reads about 8,000 characters (roughly 3 pages). Defaults to 4.
# Raise it to analyse more of a long document, at the cost of speed and AI quota.
MAX_ANALYSIS_CALLS=

# Optional. Groq model used by the tutor, mistake analysis and practice questions.
# Defaults to openai/gpt-oss-20b. It is a different model from GROQ_MODEL on purpose:
# each model has its own free tokens-per-minute limit, so these stay fast right after an upload.
GROQ_FAST_MODEL=
